{
  "git": {
    "commitMessage": "chore: release ${version}",
    "tagName": "v${version}",
    "push": true
  },
  "npm": {
    "publish": true,
    "ignoreVersion": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "hooks": {
    "before:init": ["pnpm run build"]
  }
}
