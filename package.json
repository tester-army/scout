{
  "name": "@testerarmy/scout",
  "version": "0.1.0",
  "description": "Safe API exploration harness for coding agents. Send a scout ahead of the army.",
  "keywords": [
    "agent",
    "api",
    "cli",
    "openapi",
    "qa",
    "testing"
  ],
  "homepage": "https://tester.army",
  "license": "MIT",
  "author": "Tester Army <hello@tester.army>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/scout.git"
  },
  "bin": {
    "scout": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "skills/scout/SKILL.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "test": "vitest run",
    "smoke:pack": "node pack-smoke.mjs",
    "prepack": "pnpm build",
    "release": "release-it"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@clack/prompts": "^1.7.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "^15.0.0",
    "picomatch": "4.0.5",
    "swagger2openapi": "7.0.8",
    "table": "6.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/picomatch": "4.0.3",
    "@types/swagger2openapi": "7.0.4",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "release-it": "^20.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
