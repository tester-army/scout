{
  "name": "@testerarmy/scout",
  "version": "0.0.1",
  "description": "Safe API exploration harness for coding agents. Send a scout ahead of the army.",
  "keywords": [
    "agent",
    "api",
    "cli",
    "openapi",
    "qa",
    "testing"
  ],
  "homepage": "https://tester.army",
  "license": "MIT",
  "author": "Tester Army <hello@tester.army>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/scout.git"
  },
  "bin": {
    "scout": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "test": "vitest run",
    "release": "release-it"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "release-it": "^20.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0"
}
